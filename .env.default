# DACON 제출 도구 설정 템플릿.
# 이 파일을 복사해서 .env 로 저장하세요:  cp .env.default .env
# .env 는 .gitignore 에 포함되어 커밋되지 않습니다.

# 대회 id (2026 AI Agent action 예측)
DACON_COMP_ID=236694

# 내 팀명 (리더보드에서 우리 순위를 찾을 때 사용)
DACON_TEAM_NAME=클피티

# [조회용] 세션 JWT. 로그인된 브라우저에서 F12 → Application → Cookies → dacon.io 의 `token` 값을 복사.
DACON_TOKEN=

# [제출용] 개인 API 토큰. 마이페이지 > 계정관리에서 발급. submit 에 사용.
DACON_API_TOKEN=
